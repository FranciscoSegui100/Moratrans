{
  "name": "logistica-whatsapp-backend",
  "version": "0.1.0",
  "description": "Backend: chatbot WhatsApp (Graph API) + panel logístico",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "db:schema": "psql \"$DATABASE_URL\" -f src/db/schema.sql",
    "db:seed": "psql \"$DATABASE_URL\" -f src/db/seed.sql",
    "db:seed-choferes": "tsx src/db/seedChoferes.ts"
  },
  "dependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie": "^0.6.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.7.0",
    "@types/pdfkit": "^0.13.4",
    "@types/pg": "^8.11.10",
    "@types/qrcode": "^1.5.6",
    "@types/zxcvbn": "^4.4.5",
    "axios": "^1.7.7",
    "bcryptjs": "^2.4.3",
    "cookie": "^0.7.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.21.0",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^8.6.2",
    "form-data": "^4.0.0",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^4.6.0",
    "otplib": "^12.0.1",
    "pdfkit": "^0.15.0",
    "pg": "^8.13.0",
    "qrcode": "^1.5.4",
    "resend": "^6.18.1",
    "socket.io": "^4.8.0",
    "typescript": "^5.6.0",
    "zod": "^3.23.8",
    "zxcvbn": "^4.4.2"
  },
  "devDependencies": {
    "tsx": "^4.19.1"
  }
}
