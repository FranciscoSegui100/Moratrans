# ---- Servidor ----
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# ---- Base de datos (única fuente de verdad) ----
# NUNCA pongas acá la contraseña real: este archivo se commitea al repo.
DATABASE_URL=postgresql://postgres:[PASSWORD]@[PROJECT_REF].pooler.supabase.com:6543/postgres

# ---- Auth panel ----
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_ACCESS_EXPIRES=8h
REFRESH_TTL_DIAS=30
REFRESH_TTL_RECORDAR_DIAS=90

# ---- WhatsApp Cloud API (Meta Graph API) ----
WA_GRAPH_VERSION=v21.0
WA_PHONE_NUMBER_ID=000000000000000
WA_ACCESS_TOKEN=EAAG...token-permanente
WA_VERIFY_TOKEN=token-que-configuras-en-el-webhook
WA_APP_SECRET=app-secret-para-validar-firma

# ---- Sync saliente (servidor interno del cliente) ----
SYNC_API_KEY=clave-larga-para-el-endpoint-de-replicacion

# ---- Almacenamiento de comprobantes/facturas/tickets (Supabase Storage) ----
# Bucket PRIVADO. La service_role key es secreta: nunca la expongas al frontend.
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key
SUPABASE_STORAGE_BUCKET=media

# ---- Email transaccional (Resend) ----
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=Moratrans <onboarding@resend.dev>
APP_URL=http://localhost:5173

# ---- Cifrado en reposo (AES-256-GCM) ----
# NUNCA pongas acá una clave real (este archivo se commitea al repo) — generá
# la tuya con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=64-caracteres-hex-generados-con-el-comando-de-arriba
