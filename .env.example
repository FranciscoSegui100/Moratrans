# URL de conexión de la base de datos (Supabase)
# Ejemplo: postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres?sslmode=require
DATABASE_URL=your_supabase_connection_string_here

# Credenciales de WhatsApp Cloud API (Meta Graph API)
WA_PHONE_NUMBER_ID=000000000000000
WA_ACCESS_TOKEN=EAAG...token-permanente
WA_VERIFY_TOKEN=token-que-configuras-en-el-webhook
WA_APP_SECRET=app-secret-para-validar-firma

# Comprobantes/facturas/tickets (Supabase Storage, bucket privado)
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key
SUPABASE_STORAGE_BUCKET=media

# Email transaccional (Resend)
RESEND_API_KEY=re_...

# Secretos SOLO para levantar el stack local (docker-compose.yml los lee de
# acá). Generalos con `openssl rand -hex 32` cada uno — NUNCA reutilices estos
# valores de ejemplo ni los que generes acá en Railway/producción.
JWT_SECRET=generar-con-openssl-rand-hex-32
SYNC_API_KEY=generar-con-openssl-rand-hex-32
ENCRYPTION_KEY=generar-con-openssl-rand-hex-32
